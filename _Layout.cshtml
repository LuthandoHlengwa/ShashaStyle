<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - ShashaStyle
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>


<body class="shasha-app">


    <!-- MOBILE TOP BAR -->

    <nav class="mobile-navbar d-lg-none">

        <div class="container-fluid">

            <div class="d-flex
                        justify-content-between
                        align-items-center">

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="brand-logo">

                    SHASHA<span>STYLE</span>

                </a>


                <button class="btn btn-dark"
                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#mobileSidebar">

                    ☰

                </button>

            </div>

        </div>

    </nav>


    <!-- DESKTOP SIDEBAR -->

    <aside class="sidebar d-none d-lg-flex">

        <div class="sidebar-content">


            <!-- BRAND -->

            <div class="brand-section">

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="brand-logo">

                    SHASHA<span>STYLE</span>

                </a>

                <small>
                    INVENTORY MANAGEMENT
                </small>

            </div>


            <!-- NAVIGATION -->

            <div class="navigation-section">

                <p class="nav-heading">
                    MAIN MENU
                </p>

                <a asp-controller="Orders"
                   asp-action="Index"
                   class="sidebar-link">

                    <span class="sidebar-icon">🛍️</span>

                    <span>Orders</span>

                </a>

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="sidebar-link">

                    <span class="sidebar-icon">
                        ▦
                    </span>

                    Dashboard

                </a>


                <a asp-controller="Products"
                   asp-action="Index"
                   class="sidebar-link">

                    <span class="sidebar-icon">
                        ◈
                    </span>

                    Products

                </a>


                <a asp-controller="Categories"
                   asp-action="Index"
                   class="sidebar-link">

                    <span class="sidebar-icon">
                        ◫
                    </span>

                    Categories

                </a>


                <a asp-controller="Stock"
                   asp-action="Index"
                   class="sidebar-link">

                    <span class="sidebar-icon">
                        ▣
                    </span>

                    Stock Management

                </a>


                <p class="nav-heading mt-4">
                    SYSTEM
                </p>


                <a asp-controller="Home"
                   asp-action="Index"
                   class="sidebar-link">

                    <span class="sidebar-icon">
                        ◉
                    </span>

                    Store Preview

                </a>

            </div>


            <!-- SIDEBAR FOOTER -->

            <div class="sidebar-footer">

                <div class="admin-profile">

                    <div class="admin-avatar">
                        A
                    </div>

                    <div>

                        <strong>
                            Administrator
                        </strong>

                        <small>
                            Store Manager
                        </small>

                    </div>

                </div>

            </div>

        </div>

    </aside>


    <!-- MOBILE SIDEBAR -->

    <div class="offcanvas
                offcanvas-start
                mobile-sidebar"
         tabindex="-1"
         id="mobileSidebar">

        <div class="offcanvas-header">

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="brand-logo">

                SHASHA<span>STYLE</span>

            </a>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="offcanvas">
            </button>

        </div>


        <div class="offcanvas-body">

            <p class="nav-heading">
                MAIN MENU
            </p>


            <a asp-controller="Dashboard"
               asp-action="Index"
               class="sidebar-link">

                <span class="sidebar-icon">
                    ▦
                </span>

                Dashboard

            </a>


            <a asp-controller="Products"
               asp-action="Index"
               class="sidebar-link">

                <span class="sidebar-icon">
                    ◈
                </span>

                Products

            </a>


            <a asp-controller="Categories"
               asp-action="Index"
               class="sidebar-link">

                <span class="sidebar-icon">
                    ◫
                </span>

                Categories

            </a>


            <a asp-controller="Stock"
               asp-action="Index"
               class="sidebar-link">

                <span class="sidebar-icon">
                    ▣
                </span>

                Stock Management

            </a>


            <p class="nav-heading mt-4">
                SYSTEM
            </p>


            <a asp-controller="Home"
               asp-action="Index"
               class="sidebar-link">

                <span class="sidebar-icon">
                    ◉
                </span>

                Store Preview

            </a>

        </div>

    </div>


    <!-- MAIN CONTENT -->

    <main class="main-content">


        <!-- TOP HEADER -->

        <header class="top-header d-none d-lg-flex">

            <div>

                <span class="text-muted">
                    ShashaStyle Admin
                </span>

            </div>


            <div class="header-right">

                <span class="header-status">
                    ● System Online
                </span>

                <div class="admin-mini">

                    <div class="admin-avatar">
                        A
                    </div>

                    <span>
                        Admin
                    </span>

                </div>

            </div>

        </header>


        <!-- PAGE CONTENT -->

        <div class="page-container">

            @RenderBody()

        </div>


        <!-- FOOTER -->

        <footer class="app-footer">

            <div>

                © @DateTime.Now.Year
                ShashaStyle

            </div>

            <span> 
                <div>
                    Designed by Luthando Hlengwa
                    </div>
                    </span>
           

            <div>

                Inventory Management System

            </div>

        </footer>

    </main>


    <!-- SCRIPTS -->

    <script src="~/lib/jquery/dist/jquery.min.js">
    </script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
    "Scripts",
        required: false)

</body>

</html>