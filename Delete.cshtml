@model ShashaStyle.Models.ProductVariant

@{
    ViewData["Title"] = "Delete Product Variant";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm border-danger">

                <div class="card-body p-4">

                    <h1 class="text-danger">
                        Delete Variant
                    </h1>

                    <p class="text-muted">
                        Are you sure you want to delete this
                        product variant?
                    </p>


                    <div class="alert alert-warning">

                        <strong>
                            @Model.Product?.Name
                        </strong>

                        <br />

                        Size:
                        <strong>@Model.Size</strong>

                        <br />

                        Colour:
                        <strong>@Model.Colour</strong>

                        <br />

                        SKU:
                        <strong>@Model.SKU</strong>

                        <br />

                        Stock:
                        <strong>@Model.StockQuantity</strong>

                    </div>


                    <form asp-action="Delete"
                          method="post">

                        <input type="hidden"
                               asp-for="ProductVariantId" />


                        <button type="submit"
                                class="btn btn-danger">
                            Yes, Delete Variant
                        </button>


                        <a asp-action="Index"
                           asp-route-productId="@Model.ProductId"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>