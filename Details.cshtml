@model ShashaStyle.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="container mt-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Product Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>@Model.Name</h1>

            <p class="text-muted mb-0">
                Product details and inventory variants
            </p>
        </div>

        <div>

            <a asp-action="Index"
               class="btn btn-outline-secondary me-2">
                Back
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.ProductId"
               class="btn btn-dark">
                Edit Product
            </a>

        </div>

    </div>


    <!-- Product Information -->

    <div class="row">

        <div class="col-lg-5 mb-4">

            <div class="card shadow-sm h-100">

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         class="card-img-top"
                         style="height: 350px; object-fit: cover;"
                         alt="@Model.Name" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center bg-light"
                         style="height: 350px;">

                        <span class="text-muted">
                            No Product Image
                        </span>

                    </div>
                }

                <div class="card-body">

                    <h4>@Model.Name</h4>

                    <p class="text-muted">
                        @(string.IsNullOrEmpty(Model.Description)
                                                ? "No description available."
                                                : Model.Description)
                    </p>

                </div>

            </div>

        </div>


        <div class="col-lg-7 mb-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h4 class="mb-4">
                        Product Information
                    </h4>

                    <div class="row mb-3">

                        <div class="col-sm-4 text-muted">
                            Product ID
                        </div>

                        <div class="col-sm-8">
                            <strong>
                                #@Model.ProductId
                            </strong>
                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-sm-4 text-muted">
                            Category
                        </div>

                        <div class="col-sm-8">
                            @Model.Category?.Name
                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-sm-4 text-muted">
                            Price
                        </div>

                        <div class="col-sm-8">

                            <strong class="fs-4">
                                R @Model.Price.ToString("N2")
                            </strong>

                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-sm-4 text-muted">
                            Status
                        </div>

                        <div class="col-sm-8">

                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Inactive
                                </span>
                            }

                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-sm-4 text-muted">
                            Created
                        </div>

                        <div class="col-sm-8">
                            @Model.CreatedAt
                            .ToLocalTime()
                            .ToString("dd MMM yyyy HH:mm")
                        </div>

                    </div>


                    @if (Model.UpdatedAt.HasValue)
                    {
                        <div class="row">

                            <div class="col-sm-4 text-muted">
                                Last Updated
                            </div>

                            <div class="col-sm-8">
                                @Model.UpdatedAt.Value
                                .ToLocalTime()
                                .ToString("dd MMM yyyy HH:mm")
                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- Variants -->

    <div class="card shadow-sm mb-5">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>

                    <h3 class="mb-1">
                        Product Variants
                    </h3>

                    <p class="text-muted mb-0">
                        Manage sizes, colours, SKUs and stock.
                    </p>

                </div>

                <a asp-controller="ProductVariants"
                   asp-action="Create"
                   asp-route-productId="@Model.ProductId"
                   class="btn btn-dark">
                    + Add Variant
                </a>

            </div>


            @if (Model.Variants == null ||
                        !Model.Variants.Any())
            {
                <div class="text-center py-5">

                    <h5>No variants available</h5>

                    <p class="text-muted">
                        This product doesn't have any stock
                        variants yet.
                    </p>

                    <a asp-controller="ProductVariants"
                       asp-action="Create"
                       asp-route-productId="@Model.ProductId"
                       class="btn btn-dark">
                        Add First Variant
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th>Size</th>

                                <th>Colour</th>

                                <th>SKU</th>

                                <th>Stock</th>

                                <th>Status</th>

                                <th class="text-end">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var variant in Model.Variants)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @variant.Size
                                        </strong>
                                    </td>

                                    <td>
                                        @variant.Colour
                                    </td>

                                    <td>
                                        <code>
                                            @variant.SKU
                                        </code>
                                    </td>

                                    <td>

                                        @if (variant.StockQuantity == 0)
                                        {
                                            <span class="badge bg-danger">
                                                Out of Stock
                                            </span>
                                        }
                                        else if (variant.StockQuantity <= 5)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @variant.StockQuantity Low
                                            </span>
                                        }
                                        else
                                        {
                                            <strong>
                                                @variant.StockQuantity
                                            </strong>
                                        }

                                    </td>

                                    <td>

                                        @if (variant.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">

                                        <a asp-controller="ProductVariants"
                                           asp-action="Edit"
                                           asp-route-id="@variant.ProductVariantId"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <a asp-controller="ProductVariants"
                                           asp-action="Delete"
                                           asp-route-id="@variant.ProductVariantId"
                                           class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>